	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-set JWT token if available",
					"if (pm.collectionVariables.get('jwtToken')) {",
					"    pm.request.headers.add({",
					"        key: 'Authorization',",
					"        value: 'Bearer ' + pm.collectionVariables.get('jwtToken')",
					"        skip: () => pm.request.headers.has('Authorization')",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Store JWT token from login response",
					"if (pm.response.code === 200 && pm.response.json().token) {",
					"    pm.collectionVariables.set('jwtToken', pm.response.json().token);",
					"}",
					"",
					"// Basic response validation",
					"pm.test('Status code is successful', function () {",
					"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
					"});",
					"",
					"pm.test('Response has success field', function () {",
					"    const jsonData = pm.response.json();",
					"    pm.expect(jsonData).to.have.property('success');",
					"});",
					"",
					"// Log response for debugging",
					"console.log('Response:', pm.response.json());"
				]
			}
		}
