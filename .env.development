# Local Development Environment Configuration
# Use relative URL so Create React App proxy (setupProxy.js) forwards to Laravel — avoids CORS
REACT_APP_API_BASE_URL=/api/v1
REACT_APP_API_URL=/api/v1
REACT_APP_FRONTEND_URL=http://127.0.0.1:3000
REACT_APP_ENV=development

# Backend origin for storage URLs when API is proxied (logo/images)
REACT_APP_STORAGE_URL=http://127.0.0.1:8000

# Real-time WebSocket URL (app features — not webpack hot reload)
REACT_APP_WS_URL=ws://127.0.0.1:8000/ws

# Webpack dev-server hot reload: use the same host as the browser tab (not hardcoded localhost)
WDS_SOCKET_URL=auto://0.0.0.0:0/ws

# Development-specific settings
REACT_APP_DISABLE_CORS_WARNINGS=true
REACT_APP_DEBUG_API=true

# Optional: PayPal for development
# REACT_APP_PAYPAL_CLIENT_ID=your_dev_paypal_client_id_here
