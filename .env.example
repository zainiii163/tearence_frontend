# API Configuration — live production URLs
REACT_APP_API_BASE_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_API_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_ADMIN_URL=https://api.worldwideadverts.info
REACT_APP_FRONTEND_URL=https://worldwideadverts.info
REACT_APP_ENV=production
REACT_APP_STORAGE_URL=https://api.worldwideadverts.info/storage
# Prefer a CDN URL in production for images/video (lower latency):
# REACT_APP_STORAGE_URL=https://cdn.worldwideadverts.info
REACT_APP_WS_URL=wss://api.worldwideadverts.info/ws

# Firebase (client keys — also set these in Hostinger build env)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Google Maps (client key)
REACT_APP_GOOGLE_MAPS_API_KEY=

# PayPal Configuration — Sandbox for local/QA, Live for production
# REACT_APP_PAYPAL_CLIENT_ID=your_sandbox_or_live_client_id
# REACT_APP_PAYPAL_MODE=sandbox
# Prefer server /paypal/config (PAYPAL_MODE + sandbox keys / PAYPAL_SANDBOX_MOCK)

# Disable CORS warnings (set to false in production)
REACT_APP_DISABLE_CORS_WARNINGS=false

# Enable debug mode for API calls (set to false in production)
REACT_APP_DEBUG_API=false

# For local backend: put overrides in .env.development.local (NOT .env.local).
# .env.local is loaded during `npm run build` and will bake localhost into production.
# REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api/v1
# REACT_APP_STORAGE_URL=http://127.0.0.1:8000/storage
# REACT_APP_WS_URL=ws://127.0.0.1:8000/ws

# Residual risk note: JWTs are stored in localStorage until httpOnly cookie auth is implemented.
# Mitigate with CSP + DOMPurify (XSS) and short JWT TTL on the API.
