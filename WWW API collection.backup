		{
			"name": "KYC Verification",
			"item": [
				{
					"name": "Submit KYC Documents",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "multipart/form-data"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "id_document_type",
									"value": "passport",
									"type": "text"
								},
								{
									"key": "id_document_number",
									"value": "P12345678",
									"type": "text"
								},
								{
									"key": "phone_number",
									"value": "+1234567890",
									"type": "text"
								},
								{
									"key": "date_of_birth",
									"value": "1990-01-01",
									"type": "text"
								},
								{
									"key": "nationality",
									"value": "United States",
									"type": "text"
								},
								{
									"key": "occupation",
									"value": "Software Developer",
									"type": "text"
								},
								{
									"key": "id_document",
									"src": "file://path/to/id-document.jpg",
									"type": "file"
								},
								{
									"key": "photo_with_id",
									"src": "file://path/to/selfie-with-id.jpg",
									"type": "file"
								},
								{
									"key": "address_proof_document",
									"src": "file://path/to/address-proof.pdf",
									"type": "file"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/kyc/submit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"kyc",
								"submit"
							]
						},
						"auth": {
							"type": "bearer",
							"bearer": [
