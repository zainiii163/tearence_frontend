# API Configuration — live production URLs
REACT_APP_API_BASE_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_API_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_ADMIN_URL=https://api.worldwideadverts.info
REACT_APP_FRONTEND_URL=https://worldwideadverts.info
REACT_APP_ENV=production
REACT_APP_STORAGE_URL=https://api.worldwideadverts.info/storage
# Prefer a CDN URL in production for images/video (lower latency):
# REACT_APP_STORAGE_URL=https://cdn.worldwideadverts.info
REACT_APP_WS_URL=wss://api.worldwideadverts.info/ws

# PayPal Configuration — required for authentic checkout on templates & services
# Use your PayPal Client ID (Sandbox for local, Live for production)
# REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Disable CORS warnings (set to false in production)
REACT_APP_DISABLE_CORS_WARNINGS=false

# Enable debug mode for API calls (set to false in production)
REACT_APP_DEBUG_API=false

# For local backend development only (uncomment / use .env.local):
# REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api/v1
# REACT_APP_STORAGE_URL=http://127.0.0.1:8000/storage
# REACT_APP_WS_URL=ws://127.0.0.1:8000/ws
