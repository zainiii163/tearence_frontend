# API Configuration
# For production API (recommended)
REACT_APP_API_BASE_URL=https://api.worldwideadverts.info/api

# For local backend development, uncomment and use:
# REACT_APP_API_BASE_URL=http://localhost:8000/api

# PayPal Configuration (Optional - for development)
# REACT_APP_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Disable CORS warnings in development
REACT_APP_DISABLE_CORS_WARNINGS=true

# Enable debug mode for API calls
REACT_APP_DEBUG_API=true
