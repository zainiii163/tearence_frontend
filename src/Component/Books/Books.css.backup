/* Books Components Styles */

/* Base styles */
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* BooksList Component */
.books-list {
  min-height: 100vh;
}

.book-card {
  background-color: white;
  border-radius: 0.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  transition: all 0.3s;
  overflow: hidden;
}

.book-card:hover {
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.book-card .group:hover .group-hover\:opacity-100 {
  opacity: 1;
}

/* BookDetail Component */
.book-detail-header {
  background-color: white;
  border-radius: 0.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.book-cover-large {
  position: relative;
  height: 24rem;
  background: linear-gradient(to bottom right, rgb(239 246 255), rgb(224 231 255));
}

.book-detail-info {
  padding: 1.5rem;
}

.book-metadata {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.metadata-badge {
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.25rem;
  padding-bottom: 0.25rem;
  background-color: rgb(219 234 254);
  color: rgb(29 78 216);
  font-size: 0.875rem;
  border-radius: 9999px;
}

.book-details-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
}

@media (min-width: 768px) {
  .book-details-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.book-details-grid {
  gap: 1rem;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: rgb(229 231 235);
}

.detail-label {
  color: rgb(75 85 99);
}

.detail-value {
  font-weight: 500;
}

.purchase-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.price-display {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.external-link {
  color: rgb(37 99 235);
  text-decoration: underline;
}

.external-link:hover {
  color: rgb(30 64 175);
}

/* CreateBookForm Component */
.create-book-form {
  min-height: 100vh;
  background-color: rgb(249 250 251);
  padding-top: 2rem;
  padding-bottom: 2rem;
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-section h3 {
  font-size: 1.125rem;
  font-weight: 600;
  color: rgb(17 24 39);
  margin-bottom: 1rem;
}

.form-group {
  margin-bottom: 1rem;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 1rem;
}

@media (min-width: 768px) {
  .form-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.form-label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
  color: rgb(55 65 81);
  margin-bottom: 0.5rem;
}

.form-input {
  width: 100%;
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  border: 1px solid rgb(209 213 219);
  border-radius: 0.375rem;
}

.form-input:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgb(59 130 246);
  border-color: transparent;
}

.form-input.error {
  border-color: rgb(239 68 68);
}

.form-textarea {
  width: 100%;
  padding-left: 0.75rem;
  padding-right: 0.75rem;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
  border: 1px solid rgb(209 213 219);
  border-radius: 0.375rem;
}

.form-textarea:focus {
  outline: none;
  box-shadow: 0 0 0 2px rgb(59 130 246);
  border-color: transparent;
}

.form-select {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.form-checkbox {
  @apply w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500;
}

.form-file {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.form-actions {
  @apply flex items-center justify-between pt-6 border-t;
}

.submit-button {
  @apply px-6 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2;
}

.cancel-button {
  @apply px-6 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300;
}

/* File upload area */
.file-upload-area {
  @apply border-2 border-dashed border-gray-300 rounded-lg p-6 text-center;
}

.file-upload-area.dragover {
  @apply border-blue-500 bg-blue-50;
}

.file-preview {
  @apply flex items-center justify-between p-3 bg-gray-50 rounded-lg;
}

.file-info {
  @apply flex items-center gap-3;
}

.file-icon {
  @apply w-8 h-8 text-gray-500;
}

.file-details {
  @apply text-sm;
}

.file-name {
  @apply font-medium text-gray-900;
}

.file-size {
  @apply text-gray-500;
}

.remove-file {
  @apply text-red-500 hover:text-red-700;
}

/* Image upload */
.image-upload-area {
  @apply border-2 border-dashed border-gray-300 rounded-lg p-6;
}

.image-preview-grid {
  @apply grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4;
}

.image-preview-item {
  @apply relative;
}

.image-preview-img {
  @apply w-full h-32 object-cover rounded-lg;
}

.remove-image {
  @apply absolute top-2 right-2 p-1 bg-red-500 text-white rounded-full opacity-0 transition-opacity;
}

/* Tags */
.tags-container {
  @apply flex flex-wrap gap-2;
}

.tag-item {
  @apply inline-flex items-center gap-1 px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm;
}

.tag-remove {
  @apply text-blue-500 hover:text-blue-700;
}

.tag-input-group {
  @apply flex gap-2 mb-2;
}

.tag-input {
  @apply flex-1 px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.add-tag-button {
  @apply px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700;
}

/* MyPurchases Component */
.my-purchases {
  @apply min-h-screen bg-gray-50;
}

.purchase-card {
  @apply bg-white rounded-lg shadow-md hover:shadow-lg transition-shadow duration-300 overflow-hidden;
}

.purchase-cover {
  @apply relative h-48 bg-gradient-to-br from-blue-50 to-indigo-100;
}

.purchase-status-badge {
  @apply absolute top-2 right-2;
}

.purchase-book-type-badge {
  @apply absolute top-2 left-2;
}

.purchase-info {
  @apply p-4;
}

.purchase-details {
  @apply space-y-2 mb-4 text-sm;
}

.purchase-detail-row {
  @apply flex items-center justify-between;
}

.purchase-detail-label {
  @apply text-gray-600;
}

.purchase-detail-value {
  @apply font-medium;
}

.purchase-actions {
  @apply space-y-2;
}

.purchase-button {
  @apply w-full flex items-center justify-center gap-2 px-3 py-2 rounded transition-colors duration-200;
}

.purchase-button.primary {
  @apply bg-blue-600 text-white hover:bg-blue-700;
}

.purchase-button.secondary {
  @apply bg-gray-100 text-gray-700 hover:bg-gray-200;
}

.purchase-button.success {
  @apply bg-green-600 text-white hover:bg-green-700;
}

.purchase-button.disabled {
  @apply bg-gray-100 text-gray-500 cursor-not-allowed;
}

/* Status badges */
.status-badge {
  @apply inline-flex items-center gap-1 px-2 py-1 text-xs rounded-full;
}

.status-badge.green {
  @apply bg-green-100 text-green-700;
}

.status-badge.yellow {
  @apply bg-yellow-100 text-yellow-700;
}

.status-badge.red {
  @apply bg-red-100 text-red-700;
}

.status-badge.blue {
  @apply bg-blue-100 text-blue-700;
}

/* Filters and search */
.filters-section {
  @apply bg-white border-b shadow-sm;
}

.filters-panel {
  @apply max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6;
}

.filters-grid {
  @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4;
}

.filter-group {
  @apply mb-4;
}

.filter-label {
  @apply block text-sm font-medium text-gray-700 mb-2;
}

.filter-select {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.filter-input {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.clear-filters-button {
  @apply w-full px-4 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 transition-colors duration-200;
}

.search-container {
  @apply relative max-w-2xl;
}

.search-input {
  @apply w-full pl-12 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.search-icon {
  @apply absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 w-5 h-5;
}

.search-button {
  @apply absolute right-2 top-1/2 transform -translate-y-1/2 px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors duration-200 disabled:opacity-50;
}

/* Pagination */
.pagination-container {
  @apply flex items-center justify-center gap-2 mt-8;
}

.pagination-button {
  @apply flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-md hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed;
}

.pagination-page {
  @apply px-3 py-1 rounded-md;
}

.pagination-page.active {
  @apply bg-blue-600 text-white;
}

.pagination-page.inactive {
  @apply bg-white border border-gray-300 hover:bg-gray-50;
}

.pagination-ellipsis {
  @apply px-2 text-gray-400;
}

/* Results summary */
.results-summary {
  @apply flex items-center justify-between mb-6;
}

.results-count {
  @apply text-gray-600;
}

.per-page-selector {
  @apply flex items-center gap-2;
}

.per-page-label {
  @apply text-sm text-gray-600;
}

.per-page-select {
  @apply px-3 py-1 border border-gray-300 rounded-md text-sm;
}

/* View mode toggle */
.view-mode-toggle {
  @apply flex items-center gap-2 bg-gray-100 rounded-lg p-1;
}

.view-mode-button {
  @apply p-2 rounded;
}

.view-mode-button.active {
  @apply bg-white shadow-sm;
}

/* Loading states */
.loading-container {
  @apply min-h-screen bg-gray-50 flex items-center justify-center;
}

.loading-content {
  @apply text-center;
}

.loading-spinner {
  @apply animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4;
}

.loading-text {
  @apply text-gray-600;
}

/* Empty states */
.empty-state {
  @apply text-center py-12;
}

.empty-state-icon {
  @apply w-16 h-16 text-gray-300 mx-auto mb-4;
}

.empty-state-title {
  @apply text-lg font-medium text-gray-900 mb-2;
}

.empty-state-description {
  @apply text-gray-600 mb-4;
}

.empty-state-actions {
  @apply space-x-4;
}

/* Action buttons */
.action-button {
  @apply px-4 py-2 rounded-lg transition-colors duration-200;
}

.action-button.primary {
  @apply bg-blue-600 text-white hover:bg-blue-700;
}

.action-button.secondary {
  @apply bg-gray-200 text-gray-700 hover:bg-gray-300;
}

.action-button.success {
  @apply bg-green-600 text-white hover:bg-green-700;
}

.action-button.danger {
  @apply bg-red-600 text-white hover:bg-red-700;
}

/* Icon buttons */
.icon-button {
  @apply p-2 rounded-full hover:bg-gray-100;
}

.icon-button.primary {
  @apply p-2 rounded-full hover:bg-blue-100;
}

.icon-button.danger {
  @apply p-2 rounded-full hover:bg-red-100;
}

/* Tabs */
.tabs-container {
  @apply border-b;
}

.tabs-nav {
  @apply flex space-x-8 px-6;
}

.tab-button {
  @apply py-4 px-1 border-b-2 font-medium text-sm capitalize;
}

.tab-button.active {
  @apply border-blue-500 text-blue-600;
}

.tab-button.inactive {
  @apply border-transparent text-gray-500 hover:text-gray-700;
}

.tab-content {
  @apply p-6;
}

/* Reviews */
.review-form {
  @apply mb-6 p-4 bg-gray-50 rounded-lg;
}

.review-rating {
  @apply flex gap-2 mb-4;
}

.rating-star {
  @apply p-1;
}

.rating-star.active {
  @apply text-yellow-400 fill-current;
}

.rating-star.inactive {
  @apply text-gray-300;
}

.review-textarea {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent;
}

.review-actions {
  @apply flex gap-2;
}

.review-item {
  @apply p-4 bg-gray-50 rounded-lg;
}

.review-header {
  @apply flex items-center justify-between mb-2;
}

.review-author {
  @apply flex items-center gap-2;
}

.review-avatar {
  @apply w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center;
}

.review-avatar-icon {
  @apply w-4 h-4 text-blue-600;
}

.review-author-name {
  @apply font-medium;
}

.review-meta {
  @apply flex items-center gap-2;
}

.review-rating-display {
  @apply flex;
}

.review-date {
  @apply text-sm text-gray-500;
}

.review-content {
  @apply text-gray-700;
}

/* Similar books */
.similar-books-section {
  @apply mt-8;
}

.similar-books-grid {
  @apply grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4;
}

.similar-book-card {
  @apply bg-white rounded-lg shadow-md overflow-hidden cursor-pointer hover:shadow-lg transition-shadow;
}

.similar-book-cover {
  @apply h-32 bg-gradient-to-br from-blue-50 to-indigo-100;
}

.similar-book-info {
  @apply p-4;
}

.similar-book-title {
  @apply font-semibold text-gray-900 line-clamp-2 mb-1;
}

.similar-book-author {
  @apply text-sm text-gray-600 mb-2;
}

.similar-book-footer {
  @apply flex items-center justify-between;
}

.similar-book-price {
  @apply text-green-600 font-semibold;
}

.similar-book-rating {
  @apply flex;
}

/* Progress bar */
.progress-container {
  @apply space-y-2;
}

.progress-header {
  @apply flex items-center justify-between text-sm;
}

.progress-label {
  @apply text-gray-600;
}

.progress-value {
  @apply text-gray-600;
}

.progress-bar {
  @apply w-full bg-gray-200 rounded-full h-2;
}

.progress-fill {
  @apply bg-blue-600 h-2 rounded-full transition-all duration-300;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .filters-grid {
    @apply grid-cols-1;
  }
  
  .similar-books-grid {
    @apply grid-cols-1;
  }
  
  .form-row {
    @apply grid-cols-1;
  }
  
  .book-details-grid {
    @apply grid-cols-1;
  }
  
  .results-summary {
    @apply flex-col items-start gap-4;
  }
  
  .pagination-container {
    @apply flex-wrap gap-2;
  }
}

/* Animation utilities */
.fade-in {
  animation: fadeIn 0.3s ease-in-out;
}

.slide-up {
  animation: slideUp 0.3s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* Custom scrollbar for long lists */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 3px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}
