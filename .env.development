# Local/dev builds that ship toward production should still use live media hosts
# so images never break. Override with .env.local for local API only (gitignored).
REACT_APP_API_BASE_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_API_URL=https://api.worldwideadverts.info/api/v1
REACT_APP_FRONTEND_URL=https://worldwideadverts.info
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_STORAGE_URL=https://api.worldwideadverts.info/storage
REACT_APP_APP_NAME=World Wide Adverts
REACT_APP_APP_VERSION=1.0.0
REACT_APP_WS_URL=wss://api.worldwideadverts.info/ws
REACT_APP_DEBUG=true
